generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN_STAFF
  MAIN_STOREKEEPER
  KITCHEN_STOREKEEPER
  HEAD_CHEF
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  DRAFT_NOTE          // Waiter digital slip waiting for cashier confirmation
  CONFIRMED           // Confirmed by cashier, fired to kitchen
  IN_PREPARATION      // Kitchen accepted & cooking
  READY               // Prepared & ready for serving
  SERVED              // Delivered to table
  COMPLETED           // Paid & finished
  CANCELLED           // Cancelled with documented reason
}

enum ItemPrepStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_PAY
  BANK_TRANSFER
}

enum LocationType {
  MAIN_STORE
  KITCHEN_STORE
}

enum InventoryTransactionType {
  PURCHASE_RECEIPT
  TRANSFER_DISPATCH
  TRANSFER_RECEIVE
  TRANSFER_REJECT
  PRODUCTION_CONSUMPTION
  DIRECT_SALE_DEDUCT
  WASTAGE
  ADJUSTMENT
}

enum TransferStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  RECEIVED
  REJECTED
}

enum UnitType {
  MASS
  VOLUME
  COUNT
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

model User {
  id            String         @id @default(uuid())
  name          String
  employeeCode  String?        @unique
  email         String         @unique
  pinCode       String         // 4-6 digit quick PIN for touch terminals
  passwordHash  String
  role          UserRole       @default(CASHIER)
  isActive      Boolean        @default(true)
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  ordersCreated      Order[]                @relation("CashierOrders")
  ordersWaitered     Order[]                @relation("WaiterOrders")
  shifts             CashierShift[]
  transactions       InventoryTransaction[]
  transfersRequested StockTransfer[]        @relation("TransfersRequested")
  transfersApproved  StockTransfer[]        @relation("TransfersApproved")
  expensesRecorded   Expense[]
  auditLogs          AuditLog[]
}

model CashierShift {
  id           String      @id @default(uuid())
  cashierId    String
  cashier      User        @relation(fields: [cashierId], references: [id])
  startTime    DateTime    @default(now())
  endTime      DateTime?
  openingCash  Decimal     @db.Decimal(10, 2)
  closingCash  Decimal?    @db.Decimal(10, 2)
  expectedCash Decimal?    @db.Decimal(10, 2)
  difference   Decimal?    @db.Decimal(10, 2)
  status       ShiftStatus @default(OPEN)
  notes        String?
  payments     Payment[]
}

model Unit {
  id             String     @id @default(uuid())
  name           String     @unique // Gram, Milliliter, Piece, Kilogram, Liter
  symbol         String     @unique // g, ml, pcs, kg, l
  type           UnitType   // MASS, VOLUME, COUNT
  baseMultiplier Decimal    @db.Decimal(12, 6) // e.g. 1 kg = 1000 base grams, 1 g = 1

  ingredients        Ingredient[]
  recipeIngredients  RecipeIngredient[]
  stockTransferItems StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  addons             MenuItemAddon[]
}

model Ingredient {
  id                         String    @id @default(uuid())
  sku                        String    @unique
  name                       String
  category                   String    @default("General") // Dairy, Produce, Meat, Dry Goods, Beverages
  baseUnitId                 String
  baseUnit                   Unit      @relation(fields: [baseUnitId], references: [id])
  currentCostPerBaseUnit     Decimal   @db.Decimal(12, 6) // Valuation per gram, ml, or pcs!
  reorderThresholdMain       Decimal   @db.Decimal(12, 4) @default(1000)
  reorderThresholdKitchen    Decimal   @db.Decimal(12, 4) @default(200)
  isActive                   Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  balances              InventoryBalance[]
  transactions          InventoryTransaction[]
  recipeIngredients     RecipeIngredient[]
  stockTransferItems    StockTransferItem[]
  directSoldInMenuItems MenuItem[]             @relation("DirectIngredient")
  purchaseOrderItems    PurchaseOrderItem[]
  addons                MenuItemAddon[]
}

model InventoryLocation {
  id        String       @id @default(uuid())
  name      String       @unique // Main Store, Kitchen Store
  type      LocationType @unique
  createdAt DateTime     @default(now())

  balances         InventoryBalance[]
  sourceTransfers  StockTransfer[]        @relation("SourceLocation")
  destTransfers    StockTransfer[]        @relation("DestLocation")
  srcTransactions  InventoryTransaction[] @relation("SourceTransactions")
  destTransactions InventoryTransaction[] @relation("DestTransactions")
  purchaseOrders   PurchaseOrder[]
}

model InventoryBalance {
  id               String            @id @default(uuid())
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id])
  ingredientId     String
  ingredient       Ingredient        @relation(fields: [ingredientId], references: [id])
  quantity         Decimal           @db.Decimal(12, 4) @default(0) // In base units (grams/ml/pcs)
  reservedQuantity Decimal           @db.Decimal(12, 4) @default(0)
  lastUpdatedAt    DateTime          @updatedAt

  @@unique([locationId, ingredientId])
}

model InventoryTransaction {
  id               String                   @id @default(uuid())
  transactionType  InventoryTransactionType
  sourceLocationId String?
  sourceLocation   InventoryLocation?       @relation("SourceTransactions", fields: [sourceLocationId], references: [id])
  destLocationId   String?
  destLocation     InventoryLocation?       @relation("DestTransactions", fields: [destLocationId], references: [id])
  ingredientId     String
  ingredient       Ingredient               @relation(fields: [ingredientId], references: [id])
  quantity         Decimal                  @db.Decimal(12, 4) // In base units
  unitCost         Decimal                  @db.Decimal(12, 6) // Valuation per base unit at time of event
  totalCost        Decimal                  @db.Decimal(12, 2)
  referenceId      String?                  // OrderId, TransferId, PO Number
  reason           String?
  userId           String
  user             User                     @relation(fields: [userId], references: [id])
  createdAt        DateTime                 @default(now())

  @@index([ingredientId, createdAt])
  @@index([transactionType])
}

model StockTransfer {
  id               String            @id @default(uuid())
  transferNumber   String            @unique
  sourceLocationId String
  sourceLocation   InventoryLocation @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destLocationId   String
  destLocation     InventoryLocation @relation("DestLocation", fields: [destLocationId], references: [id])
  status           TransferStatus    @default(REQUESTED)
  requestedById    String
  requestedBy      User              @relation("TransfersRequested", fields: [requestedById], references: [id])
  approvedById     String?
  approvedBy       User?             @relation("TransfersApproved", fields: [approvedById], references: [id])
  dispatchedAt     DateTime?
  receivedAt       DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items StockTransferItem[]
}

model StockTransferItem {
  id            String        @id @default(uuid())
  transferId    String
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  ingredientId  String
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])
  requestedQty  Decimal       @db.Decimal(12, 4)
  dispatchedQty Decimal?      @db.Decimal(12, 4)
  receivedQty   Decimal?      @db.Decimal(12, 4)
  unitId        String
  unit          Unit          @relation(fields: [unitId], references: [id])
}

model Category {
  id           String          @id @default(uuid())
  name         String          @unique
  displayOrder Int             @default(0)
  iconName     String?
  badgeColor   String?         // E.g. bg-emerald-800, bg-amber-600
  isActive     Boolean         @default(true)
  menuItems    MenuItem[]
  addons       MenuItemAddon[]
}

model MenuItem {
  id                 String          @id @default(uuid())
  categoryId         String
  category           Category        @relation(fields: [categoryId], references: [id])
  name               String
  description        String?
  price              Decimal         @db.Decimal(10, 2)
  isDirectSale       Boolean         @default(false) // Direct retail items (bottled water, soda)
  directIngredientId String?
  directIngredient   Ingredient?     @relation("DirectIngredient", fields: [directIngredientId], references: [id])
  prepSection        String          @default("HOT_KITCHEN") // HOT_KITCHEN, COLD_KITCHEN, BAR_COFFEE, BAKERY
  imageUrl           String?
  isAvailable        Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  recipe     Recipe?
  orderItems OrderItem[]
  addons     MenuItemAddon[]
}

model MenuItemAddon {
  id           String      @id @default(uuid())
  name         String      // e.g. "Extra Cheese", "Extra Patty", "Extra Special Sauce"
  price        Decimal     @db.Decimal(10, 2) // Extra selling price charged to customer
  ingredientId String?     // Linked inventory ingredient for stock deduction & cost calculation
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  quantity     Decimal     @db.Decimal(12, 4) @default(0) // Quantity deducted per portion in base units (e.g. grams, ml, pcs)
  unitId       String?
  unit         Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  categoryId   String?     // Optional: category-wide add-on (e.g. Burgers, Pizza, Coffee)
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  menuItemId   String?     // Optional: specific to a single menu item
  menuItem     MenuItem?   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([ingredientId])
  @@index([menuItemId])
  @@index([categoryId])
}

model Recipe {
  id               String             @id @default(uuid())
  menuItemId       String             @unique
  menuItem         MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  yieldPortions    Decimal            @db.Decimal(8, 2) @default(1)
  prepInstructions String?
  version          Int                @default(1)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(12, 4) // Grams, ml, or pcs
  unitId       String
  unit         Unit       @relation(fields: [unitId], references: [id])
}

model DiningTable {
  id          String      @id @default(uuid())
  tableNumber String      @unique
  capacity    Int         @default(4)
  status      TableStatus @default(AVAILABLE)
  orders      Order[]
}

model Order {
  id                 String         @id @default(uuid())
  orderNumber        String         @unique
  orderType          OrderType      @default(DINE_IN)
  tableId            String?
  table              DiningTable?   @relation(fields: [tableId], references: [id])
  customerName       String?
  waiterId           String?
  waiter             User?          @relation("WaiterOrders", fields: [waiterId], references: [id])
  cashierId          String
  cashier            User           @relation("CashierOrders", fields: [cashierId], references: [id])
  status             OrderStatus    @default(CONFIRMED)
  subtotal           Decimal        @db.Decimal(10, 2)
  tip                Decimal        @db.Decimal(10, 2) @default(0)
  tax                Decimal        @db.Decimal(10, 2) @default(0)
  discount           Decimal        @db.Decimal(10, 2) @default(0)
  totalAmount        Decimal        @db.Decimal(10, 2)
  paymentStatus      PaymentStatus  @default(UNPAID)
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id                  String         @id @default(uuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String
  menuItem            MenuItem       @relation(fields: [menuItemId], references: [id])
  quantity            Int            @default(1)
  unitPrice           Decimal        @db.Decimal(10, 2)
  tip                 Decimal        @db.Decimal(10, 2) @default(0)
  subtotal            Decimal        @db.Decimal(10, 2)
  specialInstructions String?
  status              ItemPrepStatus @default(PENDING)
  costAtSale          Decimal?       @db.Decimal(10, 4) // Snapshot of exact ingredient cost per portion
  selectedAddons      Json?          // Array of { id, name, price, ingredientId, quantity, unitSymbol, costAtSale }
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  cashierShiftId String?
  cashierShift   CashierShift? @relation(fields: [cashierShiftId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CASH)
  transactionRef String?
  createdAt      DateTime      @default(now())
}

model Expense {
  id           String   @id @default(uuid())
  title        String
  category     String   // UTILITIES, RENT, SALARIES, MAINTENANCE, OTHER
  amount       Decimal  @db.Decimal(10, 2)
  date         DateTime @default(now())
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  notes        String?
}

model Supplier {
  id            String          @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime        @default(now())
  purchases     PurchaseOrder[]
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  poNumber      String              @unique
  invoiceNumber String?
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  locationId    String              // Always Main Store by default
  location      InventoryLocation   @relation(fields: [locationId], references: [id])
  totalAmount   Decimal             @db.Decimal(10, 2)
  status        PurchaseStatus      @default(RECEIVED)
  notes         String?
  createdById   String
  receivedAt    DateTime            @default(now())
  createdAt     DateTime            @default(now())
  items         PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  quantity        Decimal       @db.Decimal(12, 4) // Quantity in base unit (grams / ml / pcs)
  unitCost        Decimal       @db.Decimal(12, 6) // Cost per base unit (money per gram)
  totalCost       Decimal       @db.Decimal(10, 2)
  unitId          String
  unit            Unit          @relation(fields: [unitId], references: [id])
}

model BusinessSettings {
  id                   String   @id @default("default")
  cafeName             String   @default("Nitsuh Foods & Cafe")
  currencySymbol       String   @default("ETB")
  taxRate              Decimal  @db.Decimal(5, 2) @default(15.00) // 15% Ethiopian VAT
  serviceChargeRate    Decimal  @db.Decimal(5, 2) @default(0.00)
  address              String   @default("Addis Ababa, Ethiopia")
  phone                String   @default("0966833177")
  email                String   @default("nitsuhfoods@gmail.com")
  receiptFooterMessage String   @default("From Savour Bites to Sweet Delights – We Cater It All! Bookings & Inquiries: 0966833177")
  updatedAt            DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // STOCK_ADJUSTMENT, CANCEL_ORDER, REFUND, etc.
  entityName String
  entityId   String
  oldValue   Json?
  newValue   Json?
  reason     String?
  createdAt  DateTime @default(now())
}
